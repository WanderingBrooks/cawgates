// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  decks   Deck[]
  formats Format[]
}

model Format {
  id        String   @id @default(uuid())
  name      String   @db.Citext
  userId    String
  createdAt DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks              Deck[]
  opponentArchetypes OpponentArchetype[]

  @@unique([userId, name])
}

model Deck {
  id        String   @id @default(uuid())
  name      String
  slug      String
  isPublic  Boolean  @default(false)
  userId    String
  formatId  String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  format Format  @relation(fields: [formatId], references: [id], onDelete: NoAction)
  events Event[]

  @@unique([userId, name])
  @@unique([userId, slug])
}

model OpponentArchetype {
  id        String   @id @default(uuid())
  name      String   @db.Citext
  formatId  String
  createdAt DateTime @default(now())

  format  Format  @relation(fields: [formatId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([formatId, name])
}

model Event {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  notes     String?
  deckId    String
  createdAt DateTime @default(now())

  matches Match[]
  deck    Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model Match {
  id                  String   @id @default(uuid())
  eventId             String
  opponentArchetypeId String
  wins                Int
  losses              Int
  notes               String?
  createdAt           DateTime @default(now())

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  opponentArchetype OpponentArchetype @relation(fields: [opponentArchetypeId], references: [id])
}
